<%
  String dashboardActivePage = (String) request.getAttribute("activePage");
  String dashboardContextPath = request.getContextPath();
  String dashboardUserName = (String) session.getAttribute("USER_NAME");
  Object dashboardUserId = session.getAttribute("USER_ID");
  boolean dashboardAuthenticated = (dashboardUserId != null);
  String dashboardFeaturesHref = "home".equals(dashboardActivePage) ? "#features" : dashboardContextPath + "/#features";
%>
<link rel="stylesheet" href="<%= dashboardContextPath %>/resources/css/deepscan-theme.css?v=8">
<style>
  html {
    scrollbar-gutter: stable;
  }
</style>
<nav class="fixed left-0 right-0 top-0 z-50 border-b border-[#272d35] bg-[#090b0e]/95 backdrop-blur-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="<%= dashboardContextPath %>/" class="flex items-center gap-3 cursor-pointer no-underline">
        <span class="relative flex h-10 w-10 items-center justify-center">
          <img src="<%= dashboardContextPath %>/resources/image/deepscan-mark.svg?v=30" alt="" class="h-10 w-10" width="40" height="40">
        </span>
        <span class="text-xl font-bold"><span class="text-white">Deep</span><span class="text-blue-400">Scan</span></span>
      </a>

      <div class="hidden md:flex items-center gap-7">
        <a href="<%= dashboardFeaturesHref %>" class="<%= "home".equals(dashboardActivePage) ? "text-white" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">&#44592;&#45733;</a>
        <a href="<%= dashboardContextPath %>/news" class="<%= "news".equals(dashboardActivePage) ? "text-sky-400" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">&#45684;&#49828;</a>
        <a href="<%= dashboardContextPath %>/community" class="<%= "community".equals(dashboardActivePage) ? "text-sky-400" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">&#52964;&#48036;&#45768;&#54000;</a>
        <a href="<%= dashboardContextPath %>/report" class="<%= "report".equals(dashboardActivePage) ? "text-sky-400" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">&#49888;&#44256;&#54616;&#44592;</a>
        <a href="<%= dashboardContextPath %>/history" class="<%= "history".equals(dashboardActivePage) ? "text-sky-400" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">&#44160;&#51613; &#44592;&#47197;</a>
        <a href="<%= dashboardContextPath %>/faq" class="<%= "faq".equals(dashboardActivePage) ? "text-sky-400" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">FAQ</a>
        <% if (dashboardAuthenticated) { %>
        <div class="flex items-center gap-4">
          <a href="<%= dashboardContextPath %>/mypage" class="flex items-center gap-2 <%= "mypage".equals(dashboardActivePage) ? "text-white" : "text-slate-300" %> hover:text-white transition-colors text-base font-medium">
            <i data-lucide="user-circle" class="w-5 h-5"></i>
            <span><%= dashboardUserName %></span>
          </a>
          <form action="<%= dashboardContextPath %>/api/v1/auth/logout" method="post" class="m-0 dashboard-logout-form">
            <button type="submit" class="rounded-lg border border-[#343b45] bg-[#11151a] px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-[#1a2028]">&#47196;&#44536;&#50500;&#50883;</button>
          </form>
        </div>
        <% } else { %>
        <a href="<%= dashboardContextPath %>/login" class="rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-[#090b0e] no-underline transition-colors hover:bg-slate-200">&#47196;&#44536;&#51064;</a>
        <% } %>
      </div>

      <button type="button" onclick="toggleDashboardMobileMenu()" class="md:hidden p-2 hover:bg-white/10 rounded-lg transition-colors text-white" aria-label="&#47700;&#45684; &#50676;&#44592;">
        <i id="dashboardMobileMenuIcon" data-lucide="menu" class="w-6 h-6"></i>
      </button>
    </div>
  </div>

  <div id="dashboardMobileMenu" class="hidden border-t border-[#272d35] bg-[#0c0f13] md:hidden">
    <div class="px-4 py-6 space-y-4">
      <a href="<%= dashboardFeaturesHref %>" class="block <%= "home".equals(dashboardActivePage) ? "text-white" : "text-slate-300" %> hover:text-white transition-colors py-2">&#44592;&#45733;</a>
      <a href="<%= dashboardContextPath %>/news" class="block <%= "news".equals(dashboardActivePage) ? "text-sky-400 font-medium" : "text-slate-300" %> hover:text-white transition-colors py-2">&#45684;&#49828;</a>
      <a href="<%= dashboardContextPath %>/community" class="block <%= "community".equals(dashboardActivePage) ? "text-sky-400 font-medium" : "text-slate-300" %> hover:text-white transition-colors py-2">&#52964;&#48036;&#45768;&#54000;</a>
      <a href="<%= dashboardContextPath %>/report" class="block <%= "report".equals(dashboardActivePage) ? "text-sky-400 font-medium" : "text-slate-300" %> hover:text-white transition-colors py-2">&#49888;&#44256;&#54616;&#44592;</a>
      <a href="<%= dashboardContextPath %>/history" class="block <%= "history".equals(dashboardActivePage) ? "text-sky-400 font-medium" : "text-slate-300" %> hover:text-white transition-colors py-2">&#44160;&#51613; &#44592;&#47197;</a>
      <a href="<%= dashboardContextPath %>/faq" class="block <%= "faq".equals(dashboardActivePage) ? "text-sky-400 font-medium" : "text-slate-300" %> hover:text-white transition-colors py-2">FAQ</a>
      <% if (dashboardAuthenticated) { %>
      <a href="<%= dashboardContextPath %>/mypage" class="block <%= "mypage".equals(dashboardActivePage) ? "text-white" : "text-slate-300" %> hover:text-white transition-colors py-2">
        <i data-lucide="user-circle" class="w-5 h-5 inline mr-2"></i>
        <span><%= dashboardUserName %></span>
      </a>
      <form action="<%= dashboardContextPath %>/api/v1/auth/logout" method="post" class="m-0 dashboard-logout-form">
        <button type="submit" class="block w-full px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-center text-white border border-white/10">&#47196;&#44536;&#50500;&#50883;</button>
      </form>
      <% } else { %>
      <a href="<%= dashboardContextPath %>/login" class="block w-full rounded-lg bg-white px-4 py-2.5 text-center font-semibold text-[#090b0e] no-underline transition-colors hover:bg-slate-200">&#47196;&#44536;&#51064;</a>
      <% } %>
    </div>
  </div>
</nav>
<script>
  async function performDashboardLogout() {
    try {
      await fetch("<%= dashboardContextPath %>/api/v1/auth/logout", {
        method: "POST",
        credentials: "same-origin"
      });
    } finally {
      sessionStorage.setItem("appToast", JSON.stringify({
        type: "info",
        title: "\uB85C\uADF8\uC544\uC6C3\uB418\uC5C8\uC2B5\uB2C8\uB2E4",
        description: "\uC548\uC804\uD558\uAC8C \uB85C\uADF8\uC544\uC6C3\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      }));
      window.location.href = "<%= dashboardContextPath %>/";
    }
  }

  function toggleDashboardMobileMenu() {
    var menu = document.getElementById("dashboardMobileMenu");
    var icon = document.getElementById("dashboardMobileMenuIcon");
    if (!menu || !icon) {
      return;
    }

    var isOpen = !menu.classList.contains("hidden");
    menu.classList.toggle("hidden");
    icon.setAttribute("data-lucide", isOpen ? "menu" : "x");
    if (window.lucide && typeof window.lucide.createIcons === "function") {
      window.lucide.createIcons();
    }
  }

  document.querySelectorAll(".dashboard-logout-form").forEach(function (form) {
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      performDashboardLogout();
    });
  });
</script>
